# ======================================================
# PLANTILLA DE ENTORNO - backend
# ------------------------------------------------------
# Cómo usarlo:
#   1. Copia este archivo y renómbralo a `.env`
#   2. Cambia los valores por los de tu equipo/servidor
#
# El archivo `.env` real NUNCA se sube a git (está en
# .gitignore); este `.env.example` sí, para que cualquier
# persona sepa qué variables necesita el proyecto.
# ======================================================

# Puerto donde corre la API (Express)
PORT=3000

# Base de datos MySQL
DB_HOST=localhost
DB_PORT=3306
DB_USER=root
DB_PASSWORD=cambiami_esta_clave
DB_NAME=usta_metaverso

# Orígenes permitidos para el frontend (CORS).
# En desarrollo puede quedar en * ; en producción pon la URL real,
# separadas por comas: CORS_ORIGENES=https://midominio.com
CORS_ORIGENES=*

# Secreto para firmar los JWT (sesión). CAMBIALO en producción por
# una cadena aleatoria larga; con el valor por defecto del código
# cualquiera podría firmar tokens válidos.
# Genera uno con:  openssl rand -hex 32
JWT_SECRET=cambia_este_secreto_por_una_cadena_larga_y_aleatoria

# (Opcional) Carpeta del frontend compilado que Express sirve.
# Si no existe, se usa ../../frontend/dist relativo a backend/.
# FRONT_DIST=/var/www/campus
